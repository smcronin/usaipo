{
  "functions": {
    "api/council/review/[filing_number].js": { "maxDuration": 300 },
    "api/webhook/payment.js": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/api/inventions/:filing_number", "destination": "/api/inventions/[filing_number]" },
    { "source": "/api/examine/:filing_number", "destination": "/api/examine/[filing_number]" },
    { "source": "/api/council/review/:filing_number", "destination": "/api/council/review/[filing_number]" },
    { "source": "/api/agents/:uuid", "destination": "/api/agents/index" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type" }
      ]
    }
  ]
}
